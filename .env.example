# ==============================================================================
# CivicFix AI 2.0 - Environment Configuration Template
# NOTE: Never commit your actual keys to public version control.
# Copy this file to .env or input keys into the CivicFix AI In-App Settings modal.
# ==============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (Used ONLY for administrative scripts or backend migrations, never in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Key
# Found in: Google AI Studio -> https://aistudio.google.com/app/apikey
# Set this as a secret in your Supabase Edge Function via CLI:
# supabase secrets set GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Supabase Edge Function URL (Optional custom override; defaults to [SUPABASE_URL]/functions/v1/analyze-issue)
SUPABASE_FUNCTION_ANALYZE_URL=https://your-project-ref.supabase.co/functions/v1/analyze-issue
